# --- API keys ---
# voice clone (IVC), Scribe STT, TTS, Agents — paid plan needed for IVC
ELEVENLABS_API_KEY=
# required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# required if LLM_PROVIDER=openai OR EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
# leave empty for OpenAI. For OpenRouter: https://openrouter.ai/api/v1
# (then namespace the model names below, e.g. openai/text-embedding-3-small)
# NOTE: keep comments on their own line — an inline "# ..." after an empty
# value is parsed as the value itself.
OPENAI_BASE_URL=

# --- LLM (the persona's brain; pick a fast model for voice latency) ---
# anthropic | openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=1024

# --- Embeddings (RAG). OpenAI recommended ---
# Changing EMBEDDING_DIM does NOT rebuild the existing chunks_vec table —
# delete backend/data/app.db first, or the new vectors won't insert.
# openai | fastembed
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- ElevenLabs models ---
STT_MODEL_ID=scribe_v2
# English-only agents require a v2 model (eleven_flash_v2 / eleven_turbo_v2);
# eleven_flash_v2_5 is multilingual and is rejected with language=en.
TTS_MODEL_ID=eleven_flash_v2

# --- Agent brain ---
# builtin = an ElevenLabs-hosted model + their knowledge base. The only option
#           when the persona uses an Instant Voice Clone: their API rejects a
#           custom LLM on an IVC voice.
# custom  = our own /v1 gateway with local sqlite-vec RAG. Requires a
#           Professional Voice Clone (or a library voice) plus the tunnel below.
AGENT_LLM_MODE=builtin
# Model used when AGENT_LLM_MODE=builtin (an ElevenLabs-supported id).
AGENT_LLM=claude-haiku-4-5

# --- Live-voice custom LLM webhook (only needed when AGENT_LLM_MODE=custom) ---
# any random 32+ char string; protects /v1/chat/completions
CUSTOM_LLM_SHARED_SECRET=
# your tunnel URL, e.g. https://your-name.ngrok-free.app
PUBLIC_BASE_URL=

# --- Misc ---
RAG_TOP_K=5
