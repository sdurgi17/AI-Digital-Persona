# --- API keys ---
# voice clone (IVC), Scribe STT, TTS, Agents — paid plan needed for IVC
ELEVENLABS_API_KEY=
# required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# required if LLM_PROVIDER=openai OR EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
# leave empty for OpenAI. For OpenRouter: https://openrouter.ai/api/v1
# (then namespace the model names below, e.g. openai/text-embedding-3-small)
# NOTE: keep comments on their own line — an inline "# ..." after an empty
# value is parsed as the value itself.
OPENAI_BASE_URL=

# --- LLM (the persona's brain; pick a fast model for voice latency) ---
# anthropic | openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=1024

# --- Embeddings (RAG). OpenAI recommended, esp. for Telugu documents ---
# Changing EMBEDDING_DIM does NOT rebuild the existing chunks_vec table —
# delete backend/data/app.db first, or the new vectors won't insert.
# openai | fastembed
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- ElevenLabs models ---
STT_MODEL_ID=scribe_v2
TTS_MODEL_ID=eleven_flash_v2_5

# --- Live-voice custom LLM webhook (only needed for real-time voice, M4+) ---
# any random 32+ char string; protects /v1/chat/completions
CUSTOM_LLM_SHARED_SECRET=
# your tunnel URL, e.g. https://your-name.ngrok-free.app
PUBLIC_BASE_URL=

# --- Misc ---
RAG_TOP_K=5
